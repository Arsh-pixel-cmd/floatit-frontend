# FloatIt Environment Variables Template
# Copy this file to .env and fill in the values for local development.

# Supabase Configuration
# The URL of your Supabase project (e.g., https://your-project.supabase.co)
VITE_SUPABASE_URL=your_supabase_project_url

# The public anonymous key for client-side API requests
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# The service role key for administrative/backend-only operations (keep secret!)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Secret key used for local encryption of API keys or user data (32-byte hex recommended)
ENCRYPTION_SECRET=your_32_byte_hex_encryption_secret_here

# LLM Fallback API Key (NVIDIA Nemotron 3 API Key or other fallback key)
VITE_NVIDIA_API_KEY=your_nvidia_api_key_here

# Local Development Bypass Flags
# Set to 'true' to bypass auth screen and use a mocked session for local testing
DEV_AUTH_BYPASS=true

FALLBACK_KEYS=your_key_here
